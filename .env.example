# Microsoft Rewards redemption page shown in alerts
REDEMPTION_URL=https://rewards.bing.com/redeem/sku/000885000034

# Monitor
# The default source is intentionally unconfigured and returns UNKNOWN.
# Set JSON_API only for a documented/permitted endpoint you are authorized to poll.
AVAILABILITY_MODE=disabled
AVAILABILITY_URL=
AVAILABILITY_STATUS_PATH=
IN_STOCK_VALUES=in_stock,available,true,1
OUT_OF_STOCK_VALUES=out_of_stock,unavailable,false,0
CHECK_INTERVAL_SECONDS=60
REQUEST_TIMEOUT_SECONDS=10
STATE_FILE=data/state.json
DRY_RUN=true

# Telegram (optional)
NOTIFY_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (optional)
NOTIFY_EMAIL=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
